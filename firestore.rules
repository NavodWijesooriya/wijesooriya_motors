rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwnUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'admin';
    }

    match /userRoles/{userId} {
      allow get: if isOwnUser(userId);
      allow list, write: if false;
    }

    match /users/{userId} {
      allow get: if isOwnUser(userId);
      allow list, delete: if false;
      allow create: if isOwnUser(userId)
        && request.resource.data.keys().hasOnly(['businessName', 'email', 'role', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['businessName', 'email', 'role', 'createdAt', 'updatedAt'])
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() > 0
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == (isAdmin() ? 'admin' : 'user')
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwnUser(userId)
        && request.resource.data.keys().hasOnly(['businessName', 'email', 'role', 'createdAt', 'updatedAt'])
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() > 0
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      match /{collectionName}/{documentId} {
        allow read, write: if isOwnUser(userId);
      }

      match /{collectionName}/{documentId}/{nestedDocument=**} {
        allow read, write: if isOwnUser(userId);
      }
    }

    // Legacy data remains readable by its recorded owner for one-time migration.
    // All new writes must use the user's private document tree.
    match /bikes/{bikeId} {
      allow get, list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /userSettings/{userId} {
      allow get: if isOwnUser(userId);
      allow list, create, update, delete: if false;
    }
  }
}
