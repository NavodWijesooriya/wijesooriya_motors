rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'admin';
    }

    match /userRoles/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list, write: if false;
    }

    match /bikes/{bikeId} {
      allow read: if signedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (isAdmin() || resource.data.ownerUid == request.auth.uid);
      allow delete: if signedIn() && (isAdmin() || resource.data.ownerUid == request.auth.uid);
    }

    match /userSettings/{userId} {
      allow read, write: if signedIn() && (isAdmin() || request.auth.uid == userId);
    }
  }
}